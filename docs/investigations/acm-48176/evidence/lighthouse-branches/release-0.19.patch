From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Farrell <dfarrell@redhat.com>
Date: Thu, 15 Oct 2026 16:09:21 -0400
Subject: [PATCH] Let OpenShift assign nettest helper pod UIDs

The netshoot and nginx-demo Deployments fix runAsUser at 10000.
OpenShift's restricted-v2 SCC only admits UIDs from the namespace's
allocated range, so the ReplicaSet controller cannot create the pods
and every service discovery test that uses them fails with zero pods.
Connectivity tests still pass when run as a cluster admin: they
create pods directly, so admission uses the admin's own SCC access.

Leave runAsUser unset when the target cluster serves the
security.openshift.io API group, so SCC admission assigns a UID from
the namespace range. Keep UID 10000 elsewhere: older nettest images
default to root and would otherwise fail runAsNonRoot. The lookup
retries transient errors within the operation timeout and otherwise
fails the test rather than guessing.

Claude-Session: https://claude.ai/code/session_01YTdbc3vVeY8XMVvhVmqgWD
Signed-off-by: Daniel Farrell <dfarrell@redhat.com>
---
 test/e2e/framework/deployments.go           |  41 +++-
 test/unit/framework/deployments_test.go     | 258 ++++++++++++++++++++
 test/unit/framework/framework_suite_test.go |  31 +++
 3 files changed, 328 insertions(+), 2 deletions(-)
 create mode 100644 test/unit/framework/deployments_test.go
 create mode 100644 test/unit/framework/framework_suite_test.go

diff --git a/test/e2e/framework/deployments.go b/test/e2e/framework/deployments.go
index 5f3f2ea3..4cb04ad6 100644
--- a/test/e2e/framework/deployments.go
+++ b/test/e2e/framework/deployments.go
@@ -20,6 +20,7 @@ package framework
 
 import (
 	"context"
+	"fmt"
 
 	"github.com/submariner-io/shipyard/test/e2e/framework"
 	appsv1 "k8s.io/api/apps/v1"
@@ -34,6 +35,8 @@ func (f *Framework) NewNetShootDeployment(cluster framework.ClusterIndex) *corev
 }
 
 func (f *Framework) NewNetShootDeploymentInNS(cluster framework.ClusterIndex, namespace string) *corev1.PodList {
+	runAsUser := nettestRunAsUser(cluster)
+
 	var replicaCount int32 = 1
 	netShootDeployment := &appsv1.Deployment{
 		ObjectMeta: metav1.ObjectMeta{
@@ -60,7 +63,7 @@ func (f *Framework) NewNetShootDeploymentInNS(cluster framework.ClusterIndex, na
 					AutomountServiceAccountToken: ptr.To(false),
 					SecurityContext: &corev1.PodSecurityContext{
 						RunAsNonRoot: ptr.To(true),
-						RunAsUser:    ptr.To(int64(10000)),
+						RunAsUser:    runAsUser,
 						SeccompProfile: &corev1.SeccompProfile{
 							Type: corev1.SeccompProfileTypeRuntimeDefault,
 						},
@@ -96,6 +99,8 @@ func (f *Framework) NewNetShootDeploymentInNS(cluster framework.ClusterIndex, na
 }
 
 func (f *Framework) NewNginxDeployment(cluster framework.ClusterIndex) *corev1.PodList {
+	runAsUser := nettestRunAsUser(cluster)
+
 	var replicaCount int32 = 1
 	var port int32 = 8080
 	nginxDeployment := &appsv1.Deployment{
@@ -120,7 +125,7 @@ func (f *Framework) NewNginxDeployment(cluster framework.ClusterIndex) *corev1.P
 					AutomountServiceAccountToken: ptr.To(false),
 					SecurityContext: &corev1.PodSecurityContext{
 						RunAsNonRoot: ptr.To(true),
-						RunAsUser:    ptr.To(int64(10000)),
+						RunAsUser:    runAsUser,
 						SeccompProfile: &corev1.SeccompProfile{
 							Type: corev1.SeccompProfileTypeRuntimeDefault,
 						},
@@ -170,3 +175,35 @@ func createDeployment(f *Framework, cluster framework.ClusterIndex, deployment *
 
 	return f.AwaitPodsByAppLabel(cluster, appName, deployment.Namespace, 1)
 }
+
+// nettestRunAsUser returns the pod UID for the nettest helper Deployments. OpenShift's default restricted-v2 SCC only
+// admits UIDs from the namespace's allocated range and assigns one when none is set, so leave it unset there. Elsewhere,
+// set a non-root UID explicitly because older nettest images default to root. The raw /apis request, unlike
+// Discovery().ServerGroups(), honors the context's deadline.
+func nettestRunAsUser(cluster framework.ClusterIndex) *int64 {
+	ctx, cancel := context.WithTimeout(context.Background(), framework.TestContext.OperationTimeoutToDuration())
+	defer cancel()
+
+	groups := framework.AwaitUntil("discover API groups for nettest UID selection", func() (interface{}, error) {
+		response, err := framework.KubeClients[cluster].Discovery().RESTClient().Get().AbsPath("/apis").
+			SetHeader("Accept", "application/json").Do(ctx).Get()
+		if err != nil {
+			return nil, err
+		}
+
+		groups, ok := response.(*metav1.APIGroupList)
+		if !ok {
+			return nil, fmt.Errorf("expected APIGroupList, received %T", response)
+		}
+
+		return groups, nil
+	}, framework.NoopCheckResult).(*metav1.APIGroupList)
+
+	for i := range groups.Groups {
+		if groups.Groups[i].Name == "security.openshift.io" {
+			return nil
+		}
+	}
+
+	return ptr.To(int64(10000))
+}
