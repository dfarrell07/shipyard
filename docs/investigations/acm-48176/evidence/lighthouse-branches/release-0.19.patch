+
+package framework_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"time"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	lhframework "github.com/submariner-io/lighthouse/test/e2e/framework"
+	"github.com/submariner-io/shipyard/test/e2e/framework"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/rest"
+)
+
+var _ = Describe("Nettest helper Deployments", func() {
+	var (
+		openShift *fakeCluster
+		plain     *fakeCluster
+		f         *lhframework.Framework
+	)
+
+	BeforeEach(func() {
+		openShift = &fakeCluster{openShift: true}
+		plain = &fakeCluster{}
+
+		oldClients, oldTimeout, oldImage := framework.KubeClients, framework.TestContext.OperationTimeout,
+			framework.TestContext.NettestImageURL
+		DeferCleanup(func() {
+			framework.KubeClients = oldClients
+			framework.TestContext.OperationTimeout = oldTimeout
+			framework.TestContext.NettestImageURL = oldImage
+		})
+
+		framework.KubeClients = []*kubernetes.Clientset{plain.start(), openShift.start()}
+		framework.TestContext.OperationTimeout = 2
+		framework.TestContext.NettestImageURL = "nettest"
+
+		f = &lhframework.Framework{Framework: framework.NewBareFramework("nettest-uid")}
+		f.Namespace = "nettest-uid"
+	})
+
+	builders := []struct {
+		name  string
+		build func(*lhframework.Framework, framework.ClusterIndex)
+	}{
+		{"nginx-demo", func(f *lhframework.Framework, cluster framework.ClusterIndex) {
+			f.NewNginxDeployment(cluster)
+		}},
+		{"netshoot", func(f *lhframework.Framework, cluster framework.ClusterIndex) {
+			f.NewNetShootDeployment(cluster)
+		}},
+	}
+
+	for _, builder := range builders {
+		build := builder.build
+
+		Context("for "+builder.name, func() {
+			It("should leave the UID to SCC admission only on the cluster that serves security.openshift.io", func() {
+				build(f, framework.ClusterB)
+				build(f, framework.ClusterA)
+
+				Expect(openShift.discoveries()).To(Equal(1))
+				Expect(plain.discoveries()).To(Equal(1))
+
+				Expect(openShift.podSpecs()).To(HaveLen(1))
+				Expect(openShift.podSpecs()[0].SecurityContext.RunAsUser).To(BeNil())
+				expectHardened(openShift.podSpecs()[0])
+
+				Expect(plain.podSpecs()).To(HaveLen(1))
+				Expect(plain.podSpecs()[0].SecurityContext.RunAsUser).To(HaveValue(Equal(int64(10000))))
+				expectHardened(plain.podSpecs()[0])
+			})
+
+			It("should retry transient API discovery errors", func() {
+				plain.transientFailures = 1
+
+				build(f, framework.ClusterA)
+
+				Expect(plain.discoveries()).To(Equal(2))
+				Expect(plain.podSpecs()).To(HaveLen(1))
+				Expect(plain.podSpecs()[0].SecurityContext.RunAsUser).To(HaveValue(Equal(int64(10000))))
+			})
+
+			It("should fail without creating the Deployment when API discovery fails", func() {
+				plain.discoveryStatus = http.StatusForbidden
+
+				Expect(InterceptGomegaFailure(func() { build(f, framework.ClusterA) })).To(
+					MatchError(ContainSubstring("discover API groups for nettest UID selection")))
+				Expect(plain.podSpecs()).To(BeEmpty())
+			})
+
+			It("should fail without creating the Deployment when discovery does not return an APIGroupList", func() {
+				plain.discoveryBody = `{"apiVersion":"v1","kind":"Status","status":"Success"}`
+
+				Expect(InterceptGomegaFailure(func() { build(f, framework.ClusterA) })).To(
+					MatchError(ContainSubstring("expected APIGroupList")))
+				Expect(plain.podSpecs()).To(BeEmpty())
+			})
+
+			It("should bound API discovery by the operation timeout", func() {
+				plain.stall = true
+				framework.TestContext.OperationTimeout = 1
+				start := time.Now()
+
+				Expect(InterceptGomegaFailure(func() { build(f, framework.ClusterA) })).To(
+					MatchError(ContainSubstring("context deadline exceeded")))
+				Expect(time.Since(start)).To(BeNumerically("<", 5*time.Second))
+				Expect(plain.podSpecs()).To(BeEmpty())
+			})
+		})
+	}
+})
+
+func expectHardened(spec *corev1.PodSpec) {
+	Expect(spec.AutomountServiceAccountToken).To(HaveValue(BeFalse()))
+	Expect(spec.SecurityContext.RunAsNonRoot).To(HaveValue(BeTrue()))
+	Expect(spec.SecurityContext.SeccompProfile.Type).To(Equal(corev1.SeccompProfileTypeRuntimeDefault))
+
+	container := spec.Containers[0].SecurityContext
+	Expect(container.AllowPrivilegeEscalation).To(HaveValue(BeFalse()))
+	Expect(container.ReadOnlyRootFilesystem).To(HaveValue(BeTrue()))
+	Expect(container.Capabilities.Drop).To(Equal([]corev1.Capability{"ALL"}))
+}
+
+// fakeCluster serves API discovery and records the pod templates of created Deployments. It reports a Running pod so
+// the builders' wait completes.
+type fakeCluster struct {
+	specs             []*corev1.PodSpec
+	discoveryBody     string
+	mutex             sync.Mutex
+	discoveryCount    int
+	discoveryStatus   int32
+	transientFailures int32
+	openShift         bool
+	stall             bool
+}
+
+func (c *fakeCluster) start() *kubernetes.Clientset {
+	server := httptest.NewServer(http.HandlerFunc(c.serve))
+	DeferCleanup(server.Close)
+
+	client, err := kubernetes.NewForConfig(&rest.Config{
+		Host:          server.URL,
+		ContentConfig: rest.ContentConfig{ContentType: "application/json"},
+	})
+	Expect(err).NotTo(HaveOccurred())
+
+	return client
+}
+
+func (c *fakeCluster) serve(w http.ResponseWriter, r *http.Request) {
+	defer GinkgoRecover()
+
+	w.Header().Set("Content-Type", "application/json")
+
+	switch {
+	case r.URL.Path == "/apis":
+		c.serveDiscovery(w, r)
+	case r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/deployments"):
+		deployment := &appsv1.Deployment{}
+		Expect(json.NewDecoder(r.Body).Decode(deployment)).To(Succeed())
+
+		c.mutex.Lock()
+		c.specs = append(c.specs, &deployment.Spec.Template.Spec)
+		c.mutex.Unlock()
+
+		Expect(json.NewEncoder(w).Encode(deployment)).To(Succeed())
+	case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/pods"):
+		Expect(json.NewEncoder(w).Encode(&corev1.PodList{
+			TypeMeta: metav1.TypeMeta{Kind: "PodList", APIVersion: "v1"},
+			Items:    []corev1.Pod{{Status: corev1.PodStatus{Phase: corev1.PodRunning}}},
+		})).To(Succeed())
+	default:
+		w.WriteHeader(http.StatusNotFound)
+	}
+}
+
+func (c *fakeCluster) serveDiscovery(w http.ResponseWriter, r *http.Request) {
+	c.mutex.Lock()
+	c.discoveryCount++
+	transient := c.transientFailures > 0
+	c.transientFailures--
+	c.mutex.Unlock()
+
+	switch {
+	case transient:
+		c.writeStatus(w, http.StatusServiceUnavailable, metav1.StatusReasonServiceUnavailable)
+	case c.stall:
+		select {
+		case <-r.Context().Done():
+		case <-time.After(10 * time.Second):
+			w.WriteHeader(http.StatusGatewayTimeout)
+		}
+	case c.discoveryStatus != 0:
+		c.writeStatus(w, c.discoveryStatus, metav1.StatusReasonForbidden)
+	case c.discoveryBody != "":
+		_, err := w.Write([]byte(c.discoveryBody))
+		Expect(err).NotTo(HaveOccurred())
+	default:
+		groups := &metav1.APIGroupList{TypeMeta: metav1.TypeMeta{Kind: "APIGroupList", APIVersion: "v1"}}
+
+		if c.openShift {
+			version := metav1.GroupVersionForDiscovery{GroupVersion: "security.openshift.io/v1", Version: "v1"}
+			groups.Groups = []metav1.APIGroup{{
+				Name: "security.openshift.io", Versions: []metav1.GroupVersionForDiscovery{version}, PreferredVersion: version,
+			}}
+		}
+
+		Expect(json.NewEncoder(w).Encode(groups)).To(Succeed())
+	}
+}
+
+func (c *fakeCluster) writeStatus(w http.ResponseWriter, code int32, reason metav1.StatusReason) {
+	w.WriteHeader(int(code))
+	Expect(json.NewEncoder(w).Encode(&metav1.Status{
+		TypeMeta: metav1.TypeMeta{Kind: "Status", APIVersion: "v1"},
+		Status:   metav1.StatusFailure, Code: code, Reason: reason,
+	})).To(Succeed())
+}
+
+func (c *fakeCluster) discoveries() int {
+	c.mutex.Lock()
+	defer c.mutex.Unlock()
+
+	return c.discoveryCount
+}
+
+func (c *fakeCluster) podSpecs() []*corev1.PodSpec {
+	c.mutex.Lock()
+	defer c.mutex.Unlock()
+
+	return c.specs
+}
