+func TestNettestBuildersRejectDiscoveryFailure(t *testing.T) {
+	preserveUIDTestGlobals(t)
+
+	for _, status := range []int32{http.StatusForbidden, http.StatusServiceUnavailable} {
+		for _, builder := range []string{nginxBuilder, "netshoot"} {
+			t.Run(fmt.Sprintf("%s/HTTP%d", builder, status), func(t *testing.T) {
+				var captured uidPodCapture
+				sy.KubeClients = []*kubernetes.Clientset{uidTestClient(t, false, status, &captured)}
+				f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+
+				defer func() {
+					failure := recover()
+					if failure == nil {
+						t.Error("builder ignored discovery failure")
+					} else {
+						g := gomega.NewWithT(t)
+						g.Expect(failure).To(gomega.BeAssignableToTypeOf(""))
+						g.Expect(failure).To(gomega.ContainSubstring("discover API groups for nettest UID selection"))
+						g.Expect(failure).To(gomega.ContainSubstring("Code: %d", status))
+					}
+
+					if len(captured.snapshot()) != 0 {
+						t.Error("Deployment created despite discovery failure")
+					}
+				}()
+
+				if builder == nginxBuilder {
+					f.NewNginxDeployment(sy.ClusterA)
+				} else {
+					f.NewNetShootDeploymentInNS(sy.ClusterA, "uid-proof")
+				}
+			})
+		}
+	}
+}
