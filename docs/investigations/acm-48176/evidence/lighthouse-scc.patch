+// nettestRunAsUser lets OpenShift's SCC admission choose a namespace-allowed UID.
+// Other clusters retain an explicit non-root UID for older nettest images whose
+// image configuration still defaults to root.
+func nettestRunAsUser(cluster framework.ClusterIndex) *int64 {
+	ctx, cancel := context.WithTimeout(context.Background(), framework.TestContext.OperationTimeoutToDuration())
+	defer cancel()
+
+	response, err := framework.KubeClients[cluster].Discovery().RESTClient().Get().AbsPath("/apis").
+		SetHeader("Accept", "application/json").Do(ctx).Get()
+	Expect(err).NotTo(HaveOccurred(), "discover API groups for nettest UID selection")
+
+	groups, ok := response.(*metav1.APIGroupList)
+	Expect(ok).To(BeTrue(), "discover API groups for nettest UID selection: expected APIGroupList, received %T", response)
+
+	for i := range groups.Groups {
+		if groups.Groups[i].Name == "security.openshift.io" {
+			return nil
+		}
+	}
+
+	return ptr.To(int64(10000))
+}
