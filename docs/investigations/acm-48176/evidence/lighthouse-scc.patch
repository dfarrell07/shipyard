+func TestNettestBuildersRejectInvalidDiscoveryResponses(t *testing.T) {
+	for _, testCase := range []struct{ name, body, expected string }{
+		{"empty-object", `{}`, "Kind"},
+		{"json-null", `null`, "Kind"},
+		{"missing-kind", `{"groups":[{"name":"security.openshift.io"}]}`, "Kind"},
+		{"status-success", `{"apiVersion":"v1","kind":"Status","status":"Success"}`, "expected APIGroupList"},
+		{"pod-list", `{"apiVersion":"v1","kind":"PodList","items":[]}`, "PodList"},
+		{"malformed-json", `{"apiVersion":`, "json parse error"},
+		{"empty-body", ``, "Kind"},
+	} {
+		for _, builder := range []string{nginxBuilder, "netshoot"} {
+			t.Run(testCase.name+"/"+builder, func(t *testing.T) {
+				preserveUIDTestGlobals(t)
+				var captured uidPodCapture
+				sy.KubeClients = []*kubernetes.Clientset{uidTestClient(t, false, http.StatusOK, &captured, testCase.body)}
+				f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+				assertUIDBuilderFailure(t, f, builder, testCase.expected)
+
+				if len(captured.snapshot()) != 0 {
+					t.Error("Deployment created from an invalid API group discovery response")
+				}
+			})
+		}
+	}
+}
