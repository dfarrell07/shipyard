+func uidStalledDiscoveryClient(t *testing.T, captured *uidPodCapture) (*kubernetes.Clientset, <-chan struct{}) {
+	t.Helper()
+
+	cancelled := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/deployments") {
+			captured.add(&corev1.PodSpec{})
+			t.Error("Deployment submitted before discovery completed")
+			w.WriteHeader(http.StatusInternalServerError)
+
+			return
+		}
+
+		if r.URL.Path != "/apis" || r.Header.Get("Accept") != "application/json" {
+			t.Errorf("unexpected request: %s %s Accept=%q", r.Method, r.URL.Path, r.Header.Get("Accept"))
+		}
+
+		if r.Header.Get("Authorization") != "Bearer uid-test-token" {
+			t.Errorf("request did not reuse authenticated client: %q", r.Header.Get("Authorization"))
+		}
+
+		select {
+		case <-r.Context().Done():
+			close(cancelled)
+		case <-time.After(5 * time.Second):
+			w.WriteHeader(http.StatusGatewayTimeout)
+		}
+	}))
+	t.Cleanup(server.Close)
+
+	client, err := kubernetes.NewForConfig(&rest.Config{Host: server.URL, BearerToken: "uid-test-token"})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	return client, cancelled
+}
+
+func TestNettestBuildersBoundDiscovery(t *testing.T) {
+	for _, builder := range []string{nginxBuilder, "netshoot"} {
+		t.Run(builder, func(t *testing.T) {
+			preserveUIDTestGlobals(t)
+			var captured uidPodCapture
+			client, cancelled := uidStalledDiscoveryClient(t, &captured)
+			sy.KubeClients = []*kubernetes.Clientset{client}
+			sy.TestContext.OperationTimeout = 1
+			f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+			started := time.Now()
+			assertUIDBuilderFailure(t, f, builder, "context deadline exceeded")
+
+			if time.Since(started) > 5*time.Second {
+				t.Error("discovery exceeded its configured operation timeout")
+			}
+
+			select {
+			case <-cancelled:
+			case <-time.After(time.Second):
+				t.Error("server did not observe discovery request cancellation")
+			}
+
+			if len(captured.snapshot()) != 0 {
+				t.Error("Deployment created despite discovery timeout")
+			}
+		})
+	}
+}
