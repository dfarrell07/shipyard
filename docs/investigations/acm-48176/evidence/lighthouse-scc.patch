+// These tests mutate process globals and intentionally do not run in parallel.
+func preserveUIDTestGlobals(t *testing.T) {
+	t.Helper()
+
+	oldClients, oldContext, oldGomega := sy.KubeClients, sy.TestContext, gomega.Default
+	contextCopy := *oldContext
+	sy.TestContext = &contextCopy
+	t.Cleanup(func() {
+		sy.KubeClients, sy.TestContext, gomega.Default = oldClients, oldContext, oldGomega
+	})
+
+	gomega.Default = gomega.NewGomega(func(message string, _ ...int) { panic(message) })
+}
