+func TestNettestDeploymentUIDPerCluster(t *testing.T) {
+	preserveUIDTestGlobals(t)
+	var kubernetesCapture, openshiftCapture, thirdCapture uidPodCapture
+	sy.KubeClients = []*kubernetes.Clientset{
+		uidTestClient(t, false, http.StatusOK, &kubernetesCapture),
+		uidTestClient(t, true, http.StatusOK, &openshiftCapture),
+		uidTestClient(t, true, http.StatusOK, &thirdCapture),
+	}
+	sy.TestContext.OperationTimeout = 2
+	sy.TestContext.NettestImageURL = "example.test/nettest:root-default-compatible"
+	f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+	f.Namespace = "uid-proof"
+	// Alternate all three target clusters and repeat indices to detect accidental caching or cluster-A reuse.
+	captures := []*uidPodCapture{&kubernetesCapture, &openshiftCapture, &thirdCapture}
+	for _, cluster := range []sy.ClusterIndex{sy.ClusterB, sy.ClusterC, sy.ClusterA, sy.ClusterC, sy.ClusterB} {
+		assertUIDDiscoveryTarget(t, captures, cluster, func() { f.NewNginxDeployment(cluster) })
+		assertUIDDiscoveryTarget(t, captures, cluster, func() { f.NewNetShootDeploymentInNS(cluster, f.Namespace) })
+	}
+
+	kubernetesPods, openshiftPods, thirdPods := kubernetesCapture.snapshot(), openshiftCapture.snapshot(), thirdCapture.snapshot()
+	if len(kubernetesPods) != 2 || len(openshiftPods) != 4 || len(thirdPods) != 4 {
+		t.Fatalf("captured %d cluster-A, %d cluster-B, and %d cluster-C pods", len(kubernetesPods), len(openshiftPods), len(thirdPods))
+	}
+
+	for name, specs := range map[string][]*corev1.PodSpec{
+		"Kubernetes": kubernetesPods, "OpenShift-B": openshiftPods, "OpenShift-C": thirdPods,
+	} {
+		for _, spec := range specs {
+			uid := spec.SecurityContext.RunAsUser
+			if name == "Kubernetes" && (uid == nil || *uid != 10000) {
+				t.Fatalf("Kubernetes UID=%v", uid)
+			}
+
+			if name != "Kubernetes" && uid != nil {
+				t.Fatalf("OpenShift UID override: %d", *uid)
+			}
+			assertNettestHardening(t, spec)
+		}
+	}
+}
+
+func assertUIDDiscoveryTarget(t *testing.T, captures []*uidPodCapture, target sy.ClusterIndex, build func()) {
+	t.Helper()
+
+	before := make([]int, len(captures))
+	for i, capture := range captures {
+		before[i] = capture.discoveryCount()
+	}
+
+	build()
+
+	for i, capture := range captures {
+		expected := before[i]
+		if sy.ClusterIndex(i) == target {
+			expected++
+		}
+
+		if actual := capture.discoveryCount(); actual != expected {
+			t.Errorf("target cluster %d: cluster %d discovery count=%d, want %d", target, i, actual, expected)
+		}
+	}
+}
+
+func assertNettestHardening(t *testing.T, spec *corev1.PodSpec) {
+	t.Helper()
+	g := gomega.NewWithT(t)
+	g.Expect(spec.SecurityContext.RunAsNonRoot).To(gomega.HaveValue(gomega.BeTrue()))
+	g.Expect(spec.SecurityContext.SeccompProfile.Type).To(gomega.Equal(corev1.SeccompProfileTypeRuntimeDefault))
+	g.Expect(spec.AutomountServiceAccountToken).To(gomega.HaveValue(gomega.BeFalse()))
+	sc := spec.Containers[0].SecurityContext
+	g.Expect(sc.ReadOnlyRootFilesystem).To(gomega.HaveValue(gomega.BeTrue()))
+	g.Expect(sc.AllowPrivilegeEscalation).To(gomega.HaveValue(gomega.BeFalse()))
+	g.Expect(sc.Capabilities.Drop).To(gomega.Equal([]corev1.Capability{"ALL"}))
+	g.Expect(spec.Containers[0].Resources.Requests.Cpu().String()).To(gomega.Equal("100m"))
+	g.Expect(spec.Containers[0].Resources.Limits.Memory().String()).To(gomega.Equal("256Mi"))
+}
