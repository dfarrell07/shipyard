+func TestNettestDeploymentUIDPerCluster(t *testing.T) {
+	oldClients, oldContext := sy.KubeClients, sy.TestContext
+	t.Cleanup(func() { sy.KubeClients, sy.TestContext = oldClients, oldContext })
+	gomega.RegisterFailHandler(func(message string, _ ...int) { panic(message) })
+	var kubernetesCapture, openshiftCapture uidPodCapture
+	sy.KubeClients = []*kubernetes.Clientset{
+		uidTestClient(t, false, http.StatusOK, &kubernetesCapture),
+		uidTestClient(t, true, http.StatusOK, &openshiftCapture),
+	}
+	sy.TestContext.OperationTimeout = 2
+	sy.TestContext.NettestImageURL = "example.test/nettest:root-default-compatible"
+	f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+	f.Namespace = "uid-proof"
+	// Reverse order and repeat the first cluster to detect accidental global caching.
+	for _, cluster := range []sy.ClusterIndex{sy.ClusterB, sy.ClusterA, sy.ClusterB} {
+		f.NewNginxDeployment(cluster)
+		f.NewNetShootDeploymentInNS(cluster, f.Namespace)
+	}
+
+	kubernetesPods, openshiftPods := kubernetesCapture.snapshot(), openshiftCapture.snapshot()
+	if len(kubernetesPods) != 2 || len(openshiftPods) != 4 {
+		t.Fatalf("captured %d Kubernetes and %d OpenShift pods", len(kubernetesPods), len(openshiftPods))
+	}
+
+	for name, specs := range map[string][]*corev1.PodSpec{"Kubernetes": kubernetesPods, "OpenShift": openshiftPods} {
+		for _, spec := range specs {
+			uid := spec.SecurityContext.RunAsUser
+			if name == "Kubernetes" && (uid == nil || *uid != 10000) {
+				t.Fatalf("Kubernetes UID=%v", uid)
+			}
+
+			if name == "OpenShift" && uid != nil {
+				t.Fatalf("OpenShift UID override: %d", *uid)
+			}
+			assertNettestHardening(t, spec)
+		}
+	}
+}
+
+func assertNettestHardening(t *testing.T, spec *corev1.PodSpec) {
+	t.Helper()
+	g := gomega.NewWithT(t)
+	g.Expect(spec.SecurityContext.RunAsNonRoot).To(gomega.HaveValue(gomega.BeTrue()))
+	g.Expect(spec.SecurityContext.SeccompProfile.Type).To(gomega.Equal(corev1.SeccompProfileTypeRuntimeDefault))
+	g.Expect(spec.AutomountServiceAccountToken).To(gomega.HaveValue(gomega.BeFalse()))
+	sc := spec.Containers[0].SecurityContext
+	g.Expect(sc.ReadOnlyRootFilesystem).To(gomega.HaveValue(gomega.BeTrue()))
+	g.Expect(sc.AllowPrivilegeEscalation).To(gomega.HaveValue(gomega.BeFalse()))
+	g.Expect(sc.Capabilities.Drop).To(gomega.Equal([]corev1.Capability{"ALL"}))
+	g.Expect(spec.Containers[0].Resources.Requests.Cpu().String()).To(gomega.Equal("100m"))
+	g.Expect(spec.Containers[0].Resources.Limits.Memory().String()).To(gomega.Equal("256Mi"))
+}
+
+func TestNettestBuildersRejectDiscoveryFailure(t *testing.T) {
+	oldClients := sy.KubeClients
+	t.Cleanup(func() { sy.KubeClients = oldClients })
+	gomega.RegisterFailHandler(func(message string, _ ...int) { panic(message) })
+
+	for _, status := range []int32{http.StatusForbidden, http.StatusServiceUnavailable} {
+		for _, builder := range []string{"nginx", "netshoot"} {
+			t.Run(fmt.Sprintf("%s/HTTP%d", builder, status), func(t *testing.T) {
+				var captured uidPodCapture
+				sy.KubeClients = []*kubernetes.Clientset{uidTestClient(t, false, status, &captured)}
+				f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+
+				defer func() {
+					failure := recover()
+					if failure == nil {
+						t.Error("builder ignored discovery failure")
+					} else {
+						g := gomega.NewWithT(t)
+						g.Expect(failure).To(gomega.BeAssignableToTypeOf(""))
+						g.Expect(failure).To(gomega.ContainSubstring("discover API groups for nettest UID selection"))
+						g.Expect(failure).To(gomega.ContainSubstring("Code: %d", status))
+					}
+
+					if len(captured.snapshot()) != 0 {
+						t.Error("Deployment created despite discovery failure")
+					}
+				}()
+
+				if builder == "nginx" {
+					f.NewNginxDeployment(sy.ClusterA)
+				} else {
+					f.NewNetShootDeploymentInNS(sy.ClusterA, "uid-proof")
+				}
+			})
+		}
+	}
+}
