+func TestNettestBuildersAcceptValidEmptyAPIGroupList(t *testing.T) {
+	for _, builder := range []string{nginxBuilder, "netshoot"} {
+		t.Run(builder, func(t *testing.T) {
+			preserveUIDTestGlobals(t)
+			var captured uidPodCapture
+			sy.KubeClients = []*kubernetes.Clientset{uidTestClient(t, false, http.StatusOK, &captured,
+				`{"apiVersion":"v1","kind":"APIGroupList","groups":[]}`)}
+
+			f := &lh.Framework{Framework: sy.NewBareFramework("uid-proof")}
+			if builder == nginxBuilder {
+				f.NewNginxDeployment(sy.ClusterA)
+			} else {
+				f.NewNetShootDeploymentInNS(sy.ClusterA, "uid-proof")
+			}
+
+			pods := captured.snapshot()
+			if len(pods) != 1 || pods[0].SecurityContext.RunAsUser == nil || *pods[0].SecurityContext.RunAsUser != 10000 {
+				t.Fatal("valid empty APIGroupList did not preserve plain-Kubernetes UID")
+			}
+		})
+	}
